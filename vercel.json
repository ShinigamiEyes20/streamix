{
  "functions": {
    "api/index.js": {
      "runtime": "nodejs20.x"
    }
  },
  "routes": [
    {
      "src": "/api/([^/]+)/(.*)",
      "dest": "/api/index.js?path=$1/$2"
    },
    {
      "src": "/api/([^/]+)",
      "dest": "/api/index.js?path=$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
